# Copy this file to .env and fill in your real values.

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Server 2 SSH target
CHARTMASTER_SERVER2_HOST=your-server-2-ip-or-domain
CHARTMASTER_SERVER2_USER=ubuntu
CHARTMASTER_SERVER2_PORT=22
CHARTMASTER_SERVER2_IDENTITY_FILE=/home/dnhs01/.ssh/your-server-2-key.pem
CHARTMASTER_SERVER2_DATA_DIR=/home/ubuntu/iwantdataengineer/chartmaster

# Server 2 PostgreSQL
CHARTMASTER_DB_HOST=your-server-2-ip-or-domain
CHARTMASTER_DB_PORT=5432
CHARTMASTER_DB_NAME=chartmaster
CHARTMASTER_DB_USER=chartmaster
CHARTMASTER_DB_PASSWORD=your-db-password
CHARTMASTER_POSTGRES_DSN=dbname=chartmaster user=chartmaster password=your-db-password host=your-server-2-ip-or-domain port=5432

# Local Airflow
CHARTMASTER_AIRFLOW_PORT=8081
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=chartmaster
AIRFLOW_ADMIN_PASSWORD=change-this-password

# Server 1 FastAPI (Electron data source)
CHARTMASTER_API_PORT=8000
CHARTMASTER_API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://192.168.0.5:5173,http://10.0.0.1:5173,null
